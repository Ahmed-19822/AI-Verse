# Supabase (public keys — safe in the browser; RLS protects data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe publishable key (safe in the browser)
VITE_STRIPE_PUBLISHABLE_KEY=

# Backend API origin (no trailing slash). Required in production when the API is on a different host.
# Same Vercel deployment as the frontend: use your site URL or leave unset to use the page origin.
# Local development: http://localhost:4000
VITE_API_URL=https://ai-verse-green.vercel.app

# Legacy name — still supported if VITE_API_URL is not set
# VITE_API_BASE_URL=https://ai-verse-green.vercel.app
